{
  "name": "pro-shop",
  "version": "1.0.0",
  "description": "pro-shop mern project traversy course",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "client": "npm run dev --prefix frontend",
    "start": "node backend/server.js",
    "server": "nodemon --env-file=.env backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node  --env-file=.env backend/seeder.js",
    "data:destroy": "node --env-file=.env backend/seeder.js -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllenCodess/pro-shop.git"
  },
  "author": "Allen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AllenCodess/pro-shop/issues"
  },
  "homepage": "https://github.com/AllenCodess/pro-shop#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "react-router-bootstrap": "^0.26.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
